# ---- LLM (OpenAI-compatible). Leave API key empty to run in REPLAY/TEMPLATE mode. ----
# Primary: Alibaba Cloud Model Studio (DashScope) - Qwen is the official S2 token sponsor.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Reasoning models (qwen3-*, and e.g. the Bitget hackathon gateway's qwen3.8-max) burn the whole
# token budget on chain of thought before emitting content, and gateways with a short upstream
# timeout then return HTTP 504 - measured at 244s before failing. Set this to false to send
# enable_thinking:false. Leave it unset for endpoints that do not know the parameter.
LLM_ENABLE_THINKING=false
# Long enough for a six-section research narrative, short enough to stay inside a gateway timeout.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_MS=180000
# Fallbacks that are reachable from mainland China (change LLM_BASE_URL/LLM_MODEL accordingly):
#   SiliconFlow : https://api.siliconflow.cn/v1            model=Qwen/Qwen2.5-72B-Instruct
#   ModelScope  : https://api-inference.modelscope.cn/v1   model=Qwen/Qwen2.5-72B-Instruct
# ---- Server ----
PORT=3000
# Optional: Bitget official MCP (US stocks / ETF read-only data). Unreachable from some networks
# (mainland China blocks *.bitget.com). The app probes it at startup and degrades gracefully.
BITGET_MCP_URL=https://agent.bitget.com/mcp
