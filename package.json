    "check:html": "node scripts/check-html.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:live": "node scripts/check-browser.mjs --live https://lixinde586-afk.github.io/analogdesk",
