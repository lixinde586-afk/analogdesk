# secrets - never commit
.env
.env.local

# dependencies (the project has none at runtime; keep this for tooling installs)
node_modules/

# regenerable caches and large artefacts
#   data-cache/raw/                     225 cached HTTP responses, 20.8 MB - rebuilt by `npm run build:data`
#   research/validation-results.json    20 MB machine-readable validation dump - rebuilt by `npm run verify`
data-cache/raw/
data-cache/_srv.out
data-cache/_srv.err
research/validation-results.json

# local exploration scratch (their results are reported in research/VALIDATION.md)
scripts/_*

.tmp/

# os / editor
.DS_Store
Thumbs.db
*.swp

# submission logistics: regenerated by `npm run xpost`, and a personal task list.
# They stay on the author's disk but out of the reviewed tree - the X post source text
# itself lives in submission/SUBMISSION.md section F, which IS committed.
submission/X-POST-*.txt
submission/YOUR-THREE-TASKS.md
