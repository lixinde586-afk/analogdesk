# secrets - never commit
.env
.env.local

# dependencies (the project has none at runtime; keep this for tooling installs)
node_modules/

# regenerable caches and large artefacts
#   data-cache/raw/                     225 cached HTTP responses, 20.8 MB - rebuilt by `npm run build:data`
#   research/validation-results.json    20 MB machine-readable validation dump - rebuilt by `npm run verify`
data-cache/raw/
data-cache/_srv.out
data-cache/_srv.err
research/validation-results.json

# local exploration scratch (their results are reported in research/VALIDATION.md)
scripts/_*

.tmp/

# os / editor
.DS_Store
Thumbs.db
*.swp

# submission logistics: the hackathon form text, the paste-ready X posts, the measured video
# facts and the author's task list. All of it stays on the author's disk and is regenerated by
# `npm run form:text`, `npm run xpost` and `npm run video:probe`, but none of it is project code,
# so none of it ships in the reviewed tree.
submission/
